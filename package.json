{
  "name": "smart-hisab-root",
  "private": true,
  "version": "1.0.0",
  "description": "Root scripts for Smart-Hisab mobile app and Supabase backend",
  "scripts": {
    "backend:init": "npx supabase init",
    "backend:login": "npx supabase login",
    "backend:link": "npx supabase link --project-ref \"$SUPABASE_PROJECT_REF\"",
    "backend:push": "npx supabase db push --linked",
    "backend:start": "npx supabase start",
    "backend:stop": "npx supabase stop",
    "backend:reset": "npx supabase db reset",
    "backend:status": "npx supabase status",
    "backend:types": "sh -c 'npx supabase gen types typescript --linked --schema public > supabase/types.ts'",
    "backend:types:local": "sh -c 'npx supabase gen types typescript --local --schema public > supabase/types.ts'",
    "backend:deploy": "bash ./deploy_backend.sh",
    "deploy:backend": "bash ./deploy_backend.sh",
    "clear-tenant": "bash ./scripts/clear-tenant.sh",
    "mobile:dev": "cd mobile && flutter run",
    "mobile:analyze": "cd mobile && flutter analyze"
  },
  "devDependencies": {
    "supabase": "^2.105.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.93.1"
  }
}
